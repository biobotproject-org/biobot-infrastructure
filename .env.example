# Copy to .env and fill in. The .env file is git-ignored.
# Generate strong values with:  openssl rand -base64 32

DB_ROOT_PASSWORD=change-me
DB_NAME=biobot
DB_USER=biobot
DB_PASSWORD=change-me
JWT_SECRET=change-me

# Notehub ingress: the Notehub route sends this as "Authorization: Bearer <token>".
# Generate with:  openssl rand -hex 32
NOTEHUB_INGEST_TOKEN=change-me

# Incident emails. Leave SMTP_HOST empty to disable sending.
# Gmail works with an App Password: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=BioBot <alerts@example.com>
ALERT_EMAIL_TO=you@example.com
# Public address of the dashboard, used for links in emails
DASHBOARD_URL=http://YOUR_IP
